<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.view.recetas_ia.RecetaGeneradaView">

    <LinearLayout
        android:id="@+id/headerReceta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_detalle_top_bar"
        android:orientation="horizontal"
        android:paddingTop="42dp"
        android:paddingBottom="24dp"
        android:paddingEnd="24dp"
        android:paddingStart="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgRecetaIcono"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_menu_ia_recipe" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/txtRecetaNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generando receta..."
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRecetaDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="Una combinación rápida y nutritiva." />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollReceta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/headerReceta"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/cardClasificacionReceta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_clasificacion_verde"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/txtRecetaClasificacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Clasificación: Nutritiva" />

                <TextView
                    android:id="@+id/txtRecetaClasificacionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    tools:text="Receta optimizada para tener alto contenido de fibra." />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredientes"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txtRecetaIngredientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_medium"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"
                tools:text="• 1 taza de Avena (Producto Escaneado)\n• 1/2 taza de Leche (Sugerencia IA)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pasos a Seguir"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txtRecetaPasos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_medium"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"
                tools:text="1. En la licuadora...\n2. Licúe..." />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Análisis Nutricional (Aprox.)"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txtRecetaAnalisis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_detalle_info_card"
                android:padding="16dp"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="4dp"
                tools:text="Calorías: 350 kcal\nMacros: Alta en carbohidratos..." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Advertencia de información IA no exacta"
                android:textColor="@color/text_light_gray"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomButtonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón "Generar Otro" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerarOtro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Generar Otro"
            android:backgroundTint="@color/button_dark"
            android:textColor="@color/white"
            app:cornerRadius="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginEnd="8dp"/>

        <!-- Botón "Guardar Receta" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarReceta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Guardar Receta"
            android:backgroundTint="@color/default_app"
            android:textColor="@color/white"
            app:cornerRadius="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarReceta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/headerReceta"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>