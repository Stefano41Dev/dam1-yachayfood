<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:paddingTop="32dp"
    tools:context=".ui.view.acerca_de.AcercaDeView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acerca de"
            android:textColor="@color/text_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Ten acceso a algunas configuraciones y ten información oficial de la app."
            android:textColor="@color/text_medium"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datos y Memoria"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBorrarDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/button_red"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Borrar Productos y Recetas"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_delete_white"
            app:iconGravity="textEnd" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fuente de Datos"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Base de datos comunitaria utilizada para la información de los productos."
            android:textColor="@color/text_medium"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imgLogoOpenFoodFacts"
            android:layout_width="250dp"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="Logo Open Food Facts"
            android:importantForAccessibility="no"
            android:src="@drawable/logo_off" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inteligencia Artificial"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SDK oficial de Google Gemini utilizado en esta app."
            android:textColor="@color/text_medium"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imgLogoGemini"
            android:layout_width="250dp"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="Logo Gemini"
            android:importantForAccessibility="no"
            android:src="@drawable/logo_gemini" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuestro Equipo"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEquipoInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_medium"
            android:textSize="14sp"
            tools:text="Versión: 1.0 (Curso D.A.M)\nEquipo: Alumno 1, Alumno 2, Alumno 3\n\nPropósito: ..."/>

    </LinearLayout>
</ScrollView>